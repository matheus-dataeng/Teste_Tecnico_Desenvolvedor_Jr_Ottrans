FROM python:3.12-slim-bookworm

WORKDIR /app

ENV PYTHONPATH=/app \
    PYTHONUNBUFFERED=1

COPY docker/requirements.common.txt docker/requirements.streamlit.txt /tmp/requirements/
RUN python -m pip install --no-cache-dir -r /tmp/requirements/requirements.streamlit.txt

COPY streamlit_app ./streamlit_app
COPY src ./src

EXPOSE 8501

CMD ["python", "-m", "streamlit", "run", "streamlit_app/Home.py", "--server.address=0.0.0.0", "--server.port=8501", "--browser.gatherUsageStats=false"]
